  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.26",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
